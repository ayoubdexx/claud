# ---------------------------------------------------------------------------
# DeutschPfad environment
# Copy to .env.local. Every value is optional: without a database the app runs
# on a JSON file store under .data/ so you can develop and demo immediately.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata and OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth / Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# PostgreSQL (Supabase, Neon, Railway, local Docker …)
# When empty, the app falls back to the local file store.
DATABASE_URL=""
# Supabase pooled + direct connections (optional)
DIRECT_URL=""

# Supabase (optional — used for avatar storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
